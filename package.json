{
  "name": "architecture-deck-system",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:layouts": "node scripts/verify-layout-count.mjs",
    "build": "vite build",
    "build:single": "vite build --mode single-file && node scripts/build-single-file.mjs",
    "export:html": "npm run build:single",
    "export:images": "node scripts/export-images.mjs",
    "export:pdf": "node scripts/export-pdf.mjs",
    "export:all": "npm run export:html && npm run export:images && npm run export:pdf",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "dependencies": {
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.2.19",
    "@storybook/addon-docs": "^10.2.19",
    "@storybook/addon-onboarding": "^10.2.19",
    "@storybook/react-vite": "^10.2.19",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "pdf-lib": "^1.17.1",
    "playwright": "^1.52.0",
    "pptxgenjs": "^4.0.1",
    "storybook": "^10.2.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.60.0",
    "vite": "^6.4.2",
    "vitest": "^4.1.7"
  }
}
